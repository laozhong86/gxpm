#!/bin/bash
# gxpm post-commit hook
# Runs after a commit is created. Updates the native wiki so queries stay current.
set +e

if [ -x "./bin/gxpm" ]; then
  GXPM_BIN="./bin/gxpm"
elif command -v gxpm >/dev/null 2>&1; then
  GXPM_BIN="$(command -v gxpm)"
else
  exit 0
fi

# Only update if wiki has been initialized previously
if [ -f ".gxpm/wiki/state.json" ]; then
  "$GXPM_BIN" wiki update >/dev/null 2>&1 || true
fi

exit 0
