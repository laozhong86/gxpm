{
  "name": "@geminix/gxpm",
  "version": "0.2.2",
  "description": "Second-generation project management runtime designed to replace PMC and gstack.",
  "type": "module",
  "bin": {
    "gxpm": "./bin/gxpm",
    "gxpm-config": "./bin/gxpm-config",
    "gxpm-investigate": "./bin/gxpm-investigate",
    "gxpm-init": "./bin/gxpm-init",
    "gxpm-uninstall": "./bin/gxpm-uninstall",
    "gxpm-update-check": "./bin/gxpm-update-check"
  },
  "files": [
    "bin/",
    "core/",
    "scripts/",
    "hosts/",
    "skills/",
    "templates/",
    "agents/",
    "docs/",
    "commands/",
    "CANON.md",
    "AGENTS.md",
    "CONTEXT.md",
    "CLAUDE.md",
    "DEBUG.md",
    "README.md",
    "skills-lock.json"
  ],
  "scripts": {
    "check": "bun run scripts/gxpm-check.ts",
    "dev:skill": "bun run scripts/dev-skill.ts",
    "gen:skill-docs": "bun run scripts/gen-skill-docs.ts",
    "sync:markdown": "bun run scripts/sync-markdown-artifacts.ts",
    "test": "bun test",
    "prepublishOnly": "bun run scripts/gxpm-check.ts && bun test --timeout 30000"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "playwright": "^1.59.1",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  }
}
