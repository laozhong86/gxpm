#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "${1:-}" in
  --install-hooks)
    shift
    exec bun run "$ROOT/scripts/install-hooks.ts" "$@"
    ;;
  --install-skill)
    shift
    exec bun run "$ROOT/scripts/install-skill.ts" "$@"
    ;;
  *)
    exec bun run "$ROOT/scripts/gen-skill-docs.ts" "$@"
    ;;
esac
