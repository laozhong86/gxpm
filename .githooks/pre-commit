#!/bin/bash
# gxpm dispatcher (installed by gxpm-init --install-hooks)
# Calls gxpm-specific and third-party hooks if present; harmless otherwise.
set -e
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

# gxpm phase gate (blocking — must pass before commit is allowed)
if [ -x "$HOOK_DIR/gxpm-pre-commit" ]; then
  "$HOOK_DIR/gxpm-pre-commit"
fi

